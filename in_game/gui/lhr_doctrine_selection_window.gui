# Deprecated: retained for compatibility/reference only.
# Doctrine selection now uses vanilla army_doctrine_law via lhr_military_training_reform.
types LHRDoctrineWindowTypes {
	type LHRDoctrineRow = widget {
		layoutpolicy_horizontal = expanding
		size = { -1 90 }

		scroll_card = {
			using = bg_small_menu
			using = bg_age_event_frame
			
			size = { 100% 100 }
			parentanchor = hcenter|bottom

			hbox = {
				using = layoutpolicy_expanding
				margin = { 14 0 }
				spacing = 2

				widget = {
					size = { 48 42 }

					icon = {
						parentanchor = center
						size = { 40 40 }
						block "icon_texture" {
							texture = "gfx/interface/icons/modifier_types/army_infantry_power.dds"
						}
						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = {0.0 0.0 0.0 1.0}
							alpha = 0.3
						}
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 20 }

					vbox = {
						parentanchor = center
						layoutpolicy_horizontal = expanding
						spacing = -30

						text_single = {
							autoresize = yes
							maximumsize = { 800 -1 }
							align = left|nobaseline
							using = Font_Type_Headers
							using = Font_Size_Normal
							default_format = "#yellow_titles"
							block "title_text" {
								text = "lhr_choose_infantry_doctrine"
							}
						}

						text_multi = {
							maximumsize = { 300 34 }
							autoresize = yes
							align = left|nobaseline
							using = Font_Type_Standard
							using = Font_Size_Small
							default_format = "#medium"
							block "desc_text" {
								text = "lhr_doctrine_selection_infantry_desc"
							}
						}
					}
				}

				widget = {
					size = { 198 44 }

					
					action_button_regular = {
						using = bg_button_flavor_2

						parentanchor = bottom
						size = { 184 30 }
						actor = "[Player]"
						block "button_text" {
							text = "lhr_choose_infantry_doctrine"
						}
						left_click_and_hold_action = {
							block "button_action" {
								action_name = "lhr_choose_infantry_doctrine"
							}
						}
						block "button_tooltip" {
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" {
										text = "lhr_choose_infantry_doctrine"
									}
									blockoverride "tooltip_content" {
										using = action_tooltip_inner_content
									}
									blockoverride "tooltip_ui_action_block" {
										TooltipUIActionBlockOld = {
											visible = "[PdxGuiWidget.HasUIAction]"
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

window = {
	name = "lhr_doctrine_selection_window"
	parentanchor = center
	size = { 100% 100% }
	alwaystransparent = yes
	visible = no

	widget = {
		size = { 100% 100% }
		parentanchor = center
		button = {
			size = { 100% 100% }
			tooltip_enabled = no
			onclick = "[GetVariableSystem.Toggle( 'lhr_doctrine_selection_open' )]"
		}
	}

	widget = {
		parentanchor = center
		size = { 700 545 }
		alwaystransparent = no
		allow_outside = yes
		datacontext = "[Player]"

		vbox = {
			margin = { 10 10 }
			spacing = 0

			hbox = {
				AgeEventTitle = {
				allow_outside = yes
				align = center|nobaseline
				default_format = "#yellow_titles"
				text = "lhr_doctrine_selection_header"
				tooltip = "[EventWindow.GetDebugInfo]"

				
			}
			}

			vbox = {
				using = layoutpolicy_expanding
				using = bg_age_event_inner
				using = bg_age_event_frame
				allow_outside = yes
				margin = { 12 0 }

				vbox = {
					using = layoutpolicy_expanding
					margin = { 14 14 }
					spacing = -20



					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 52 }
						using = bg_card_header_01_military

						using = bg_age_event_frame
						using = bg_text_mask_container_dark_brown


						hbox = {
							layoutpolicy_horizontal = expanding
							parentanchor = left|vcenter
							margin = { 14 0 }
							spacing = 8

							icon = {
								size = { 24 24 }
								texture = "gfx/interface/icons/flat_icons/army_tradition.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = {0.0 0.0 0.0 1.0}
									alpha = 0.3
								}
							}

							text_multi = {
								layoutpolicy_horizontal = expanding
								maximumsize = { 558 -1 }
								autoresize = yes
								text = "lhr_doctrine_selection_intro"
								align = left|nobaseline
								using = Font_Type_Standard
								using = Font_Size_Small
								default_format = "#white"
								
							}
						}
					}

					scrollarea = {
						using = layoutpolicy_expanding
						scrollbarpolicy_horizontal = always_off

						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}

						scrollwidget = {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = -75

								LHRDoctrineRow = {
									blockoverride "active_background" {
										background = {
											visible = "[GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('lhr_doctrine_infantry_active'), '(CFixedPoint)0')]"
											texture = "gfx/interface/component_overlay/card_title_glow.dds"
											texture_density = 2
											blend_mode = overlay
											alpha = 0.1
											glow = { glow_radius = 5 color = { 1.0 0.85 0.55 1.0 } alpha = 0.2 }
										}
									}
									blockoverride "icon_texture" {
										texture = "gfx/interface/icons/modifier_types/army_infantry_power.dds"
									}
									blockoverride "title_text" {
										text = "lhr_choose_infantry_doctrine"
									}
									blockoverride "desc_text" {
										text = "lhr_doctrine_selection_infantry_desc"
									}
									blockoverride "current_visible" {
										visible = "[GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('lhr_doctrine_infantry_active'), '(CFixedPoint)0')]"
									}
									blockoverride "button_text" {
										text = "lhr_choose_infantry_doctrine"
									}
									blockoverride "button_action" {
										action_name = "lhr_choose_infantry_doctrine"
									}
									blockoverride "button_tooltip" {
										tooltipwidget = {
											ContextualTooltipType = {
												blockoverride "title_text" {
													text = "lhr_choose_infantry_doctrine"
												}
												blockoverride "tooltip_content" {
													using = action_tooltip_inner_content
												}
												blockoverride "tooltip_ui_action_block" {
													TooltipUIActionBlockOld = {
														visible = "[PdxGuiWidget.HasUIAction]"
													}
												}
											}
										}
									}
								}

								LHRDoctrineRow = {
									blockoverride "active_background" {
										background = {
											visible = "[GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('lhr_doctrine_cavalry_active'), '(CFixedPoint)0')]"
											texture = "gfx/interface/component_overlay/card_title_glow.dds"
											texture_density = 2
											blend_mode = overlay
											alpha = 0.1
											glow = { glow_radius = 5 color = { 1.0 0.85 0.55 1.0 } alpha = 0.2 }
										}
									}
									blockoverride "icon_texture" {
										texture = "gfx/interface/icons/modifier_types/army_cavalry_power.dds"
									}
									blockoverride "title_text" {
										text = "lhr_choose_cavalry_doctrine"
									}
									blockoverride "desc_text" {
										text = "lhr_doctrine_selection_cavalry_desc"
									}
									blockoverride "current_visible" {
										visible = "[GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('lhr_doctrine_cavalry_active'), '(CFixedPoint)0')]"
									}
									blockoverride "button_text" {
										text = "lhr_choose_cavalry_doctrine"
									}
									blockoverride "button_action" {
										action_name = "lhr_choose_cavalry_doctrine"
									}
									blockoverride "button_tooltip" {
										tooltipwidget = {
											ContextualTooltipType = {
												blockoverride "title_text" {
													text = "lhr_choose_cavalry_doctrine"
												}
												blockoverride "tooltip_content" {
													using = action_tooltip_inner_content
												}
												blockoverride "tooltip_ui_action_block" {
													TooltipUIActionBlockOld = {
														visible = "[PdxGuiWidget.HasUIAction]"
													}
												}
											}
										}
									}
								}

								LHRDoctrineRow = {
									blockoverride "active_background" {
										background = {
											visible = "[GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('lhr_doctrine_artillery_active'), '(CFixedPoint)0')]"
											texture = "gfx/interface/component_overlay/card_title_glow.dds"
											texture_density = 2
											blend_mode = overlay
											alpha = 0.1
											glow = { glow_radius = 5 color = { 1.0 0.85 0.55 1.0 } alpha = 0.2 }
										}
									}
									blockoverride "icon_texture" {
										texture = "gfx/interface/icons/modifier_types/army_artillery_power.dds"
									}
									blockoverride "title_text" {
										text = "lhr_choose_artillery_doctrine"
									}
									blockoverride "desc_text" {
										text = "lhr_doctrine_selection_artillery_desc"
									}
									blockoverride "current_visible" {
										visible = "[GreaterThan_CFixedPoint(Player.MakeScope.ScriptValue('lhr_doctrine_artillery_active'), '(CFixedPoint)0')]"
									}
									blockoverride "button_text" {
										text = "lhr_choose_artillery_doctrine"
									}
									blockoverride "button_action" {
										action_name = "lhr_choose_artillery_doctrine"
									}
									blockoverride "button_tooltip" {
										tooltipwidget = {
											ContextualTooltipType = {
												blockoverride "title_text" {
													text = "lhr_choose_artillery_doctrine"
												}
												blockoverride "tooltip_content" {
													using = action_tooltip_inner_content
												}
												blockoverride "tooltip_ui_action_block" {
													TooltipUIActionBlockOld = {
														visible = "[PdxGuiWidget.HasUIAction]"
													}
												}
											}
										}
									}
								}
							}
						}
					}

					widget = {
						layoutpolicy_horizontal = expanding
						size = { -1 0 }
						allow_outside = yes

						AgeEventDecorationTop2 = {
							mirror = horizontal
							parentanchor = left|bottom
							widgetanchor = right|bottom
							position = { 0 20 }
						}

						AgeEventDecorationTop2 = {
							parentanchor = right|bottom
							widgetanchor = left|bottom
							position = { 0 20 }
						}
					}
				}
			}
		}
	}
}